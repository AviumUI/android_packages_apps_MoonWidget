<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_surface"
    android:contentDescription="@string/character_widget_description">

    <ImageView
        android:id="@+id/image_mianbu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/mianbu" />

    <ImageView
        android:id="@+id/image_hudiejie"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hudiejie" />

    <ImageView
        android:id="@+id/image_toufa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/toufa" />


    <ImageView
        android:id="@+id/image_yanjin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/yanjin" />

    <TextView
        android:id="@+id/text_character_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/widget_accent_chip"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="@string/character_morning"
        android:textColor="@color/widget_on_primary"
        android:textSize="12sp" />

</FrameLayout>
