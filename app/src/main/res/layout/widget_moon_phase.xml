<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:contentDescription="@string/moon_phase_description"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/image_moon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/moon_phase_widget_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_moon_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/moon_phase_today"
            android:textColor="@color/widget_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_moon_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/moon_phase_full"
            android:textColor="@color/widget_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_moon_illumination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moon_phase_illumination"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_moon_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/moon_phase_next"
            android:textColor="@color/widget_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
